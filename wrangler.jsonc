{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boalbasaur",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true
  },
  // The site is still files. worker.js claims /api/send and hands everything
  // else to ASSETS, which is what the binding is for.
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
